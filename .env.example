# ==============================================================================
# HEATSHIELD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit secret keys.
# ==============================================================================

# Supabase Project Configuration (Obtain from your Supabase Dashboard: Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here

# Optional: Weather API & Geolocation (Default uses Open-Meteo public endpoints)
VITE_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Optional: Application Environment
VITE_APP_ENV=production
