# WhatsApp Service Configuration
PORT=3100
HOST=localhost

# Security — set a strong random secret for the HeatShield app to authenticate against this service
API_SECRET=change-me-to-a-long-random-string

# CORS origin — your frontend URL
FRONTEND_ORIGIN=http://localhost:5173

# Session folder for Baileys auth credentials (WhatsApp login state)
SESSION_DIR=./sessions

# Max retries for failed WhatsApp message sends
MAX_RETRIES=3

# Optional: set to 'true' to run in dry-run / sandbox mode (logs messages but does not actually send)
DRY_RUN=false
