{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@heatshield/types": ["./packages/types/index.ts"],
      "@heatshield/types/*": ["./packages/types/*"],
      "@heatshield/core": ["./packages/core/index.ts"],
      "@heatshield/core/*": ["./packages/core/*"],
      "@heatshield/api": ["./packages/api/index.ts"],
      "@heatshield/api/*": ["./packages/api/*"]
    }
  },
  "include": ["src", "packages"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
